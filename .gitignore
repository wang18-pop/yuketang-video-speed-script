# Release allowlist: historical desktop files stay local.
/*
!/.gitignore
!/README.md
!/AUDIT.md
!/THIRD_PARTY.md
!/package.json
!/package-lock.json
!/agent-5x.mjs
!/ykt-5x.js
!/test/
/test/*
!/test/fixture.mjs
!/test/tool.test.mjs
!/test/browser-smoke.mjs
# Defense in depth, including files in future subdirectories.
**/node_modules/
**/.env*
**/*credential*
**/*secret*
**/*token*
**/*cookie*
**/*.log
**/*.har
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.mp4
**/*.webm
**/User Data/
**/*profile*/
**/.local-backup/
